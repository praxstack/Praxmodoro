{
  "name": "praxmodoro-spec-tooling",
  "version": "0.1.0",
  "private": true,
  "description": "Pinned specification tooling for the native Praxmodoro macOS app.",
  "scripts": {
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "tokens:build": "node scripts/generate-design-tokens.mjs",
    "spec:list": "openspec list",
    "docs:build": "node scripts/build-docs.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.6.0",
    "marked": "^15.0.12"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@10.9.8"
}
